#creating histograms showing feature distribution, both raw and scaled

from sklearn import preprocessing

out_df_h = pandas.read_csv('PATH_TO_OUTPUT_FILE.csv')
out_df_c = pandas.read_csv('PATH_TO_DATA_WITH_SAMPLE_LABELS.csv')

features = ['Intg @ t1', 'Depth @ t1', 'Depth/width @ t1']
outputs = ['Defect Radius', 'Defect Height', 'Defect Depth']
   
X_h = out_df_h[features]
h_raw = pandas.DataFrame(X_h)
X_h = X_h.to_numpy()
scaler_h = preprocessing.RobustScaler()
X_h_scaled = scaler_h.fit_transform(X_h)
h_scaled = pandas.DataFrame(X_h_scaled, columns=features)

X_c = out_df_c[features]
c_raw = pandas.DataFrame(X_c)
X_c = X_c.to_numpy()
scaler_c = preprocessing.RobustScaler()
X_c_scaled = scaler_c.fit_transform(X_c)
c_scaled = pandas.DataFrame(X_c_scaled, columns=features)

for i in range(len(features)):
    for j, df in enumerate([h_raw, h_scaled, c_raw, c_scaled]):
        df[features[i]].hist(bins=60)
        if j == 0:
            plt.title('Raw Heat-induced (standard) IRT')
        elif j == 1:
            plt.title('Scaled Heat-induced (standard) IRT')
        elif j == 2:
            plt.title('Raw CI-IRT')
        elif j == 3:
            plt.title('Scaled CI-IRT')
        plt.xlabel(f'{features[i]} Values')
        plt.ylabel('Frequency')
        plt.show()
