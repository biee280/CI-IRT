def full_correlation_and_averages(out_df):
    #creates a correlation table of all features, including sample parameters to select best features
    corr_df = out_df.drop(columns='Sample Index', axis=1)
    correlation_matrix = corr_df.corr(numeric_only=True)
    labels = correlation_matrix.columns.to_list()
    
    correlation_arr = correlation_matrix.to_numpy()
    
    fig, ax = plt.subplots(figsize=(14, 10))
    im = ax.imshow(correlation_matrix)
    
    cbar = ax.figure.colorbar(im, ax = ax)
    cbar.ax.set_ylabel("Color bar", rotation = -90, va = "bottom")
    
    ax.set_xticks(np.arange(len(labels)), labels = labels)
    ax.set_yticks(np.arange(len(labels)), labels = labels)
    
    plt.setp(ax.get_xticklabels(), rotation = 90,
             ha = "right", rotation_mode = "anchor")

    values = []
    averages = []
    
    for i in range(len(labels)):
        for j in range(len(labels)):
            text = ax.text(j, i, round(correlation_arr[i, j], 3),
                           ha = "center", va = "center", color = "w")
            if j == 14 or j ==15 or j ==16:
                values.append(float(correlation_arr[i, j]))

    for x in range(0, len(values), 3):
        averages.append(statistics.mean([abs(values[x]), abs(values[x+1]), abs(values[x+2])]))

    plt.show()
    return averages[:14]

